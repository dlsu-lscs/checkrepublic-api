# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN=*

# Database (local PostgreSQL 16: `docker compose up -d db`, see docker-compose.yml)
# docker compose reads POSTGRES_* from .env to create the database on first start.
POSTGRES_DB=checkrepublic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Connection string for the API; keep it in sync with the three values above.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/checkrepublic
